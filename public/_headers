/*
 * Security headers for static files only. Server-rendered HTML gets its
 * Content-Security-Policy from src/server.ts with per-response script hashes;
 * browsers intersect multiple CSP headers, so it must not be set here too.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

